---
import CrmApp from "@/components/crm/CrmApp";
import { tableLayouts } from "@/generated/crm/manifest";
import CrmRootLayout from "@/layouts/crm-root-layout.astro";

export function getStaticPaths() {
  return tableLayouts.map((layout) => ({
    params: { table: layout.slug },
    props: { tableId: layout.tableId, name: layout.name },
  }));
}

const { tableId, name } = Astro.props;
---

<CrmRootLayout title={`${name} - CRM - ALDR`}>
  <CrmApp tableId={tableId} client:only="react" />
</CrmRootLayout>
