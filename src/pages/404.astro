---
import '@/styles/globals.css';

import PageLayout from '../layouts/page-layout.astro';

const supabaseBaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const functionUrl = supabaseBaseUrl.includes('.supabase.co')
  ? supabaseBaseUrl.replace('.supabase.co', '.supabase.co/functions/v1/url_shortener')
  : `${supabaseBaseUrl}/functions/v1/url_shortener`;
---
<script define:vars={{ functionUrl }}>
  const path = window.location.pathname;
  if (path.startsWith('/s/')) {
    console.info(`[Aldreme Router] Intercepted fallback pattern for short URL: ${path}`);
    
    // Hide the 404 interface to prevent visual flashing during the redirect
    document.documentElement.style.display = 'none';

    const slug = path.split('/s/')[1];
    if (slug) {
      console.info(`[Aldreme Router] Slug '${slug}' identified. Redirecting to validation gateway...`);
      // Use replace() so the 404 doesn't get trapped in the browser's back-button history
      window.location.replace(`${functionUrl}?slug=${slug}`);
    } else {
      console.warn(`[Aldreme Router] Short URL pattern detected but no slug found. Displaying 404.`);
      document.documentElement.style.display = 'block';
    }
  }
</script>
<PageLayout>
  <main class="grid min-h-full place-items-center bg-white px-6 py-24 sm:py-32 lg:px-8">
    <div class="text-center">
      <p class="text-base font-semibold text-indigo-600">404</p>
      <h1 class="mt-4 text-balance text-5xl font-semibold tracking-tight text-gray-900 sm:text-7xl">Page not found</h1>
      <p class="mt-6 text-pretty text-lg font-medium text-gray-500 sm:text-xl/8">Sorry, we couldn’t find the page you’re looking for.</p>
      <div class="mt-10 flex items-center justify-center gap-x-6">
        <a href="/" class="rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Go back home</a>
        <a href="/contact" class="text-sm font-semibold text-gray-900">Contact support <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </main>
</PageLayout>